# Copy to .env, or supply these public settings to the Vite build process.
# All VITE_ values are public browser configuration. Do not put secrets here.
# For a container/CI build, set them before npm run build/build:staging;
# adding them only when PM2/the static server starts does not change the bundle.

# Required: public Strapi origin, without a trailing /api path.
# Used for both API requests and uploaded media URLs. Use HTTPS on hosted sites.
VITE_STRAPI_URL=

# Required for the bibliography: numeric Zotero group ID with a public library.
# Reads are unauthenticated; no Zotero API key is needed.
VITE_ZOTERO_GROUP_ID=

# Optional: public pk. token for Coins on a Map (currently staging-only).
# Leave empty if the map is not needed; sk. secret tokens are rejected.
VITE_MAPBOX_TOKEN=

# Optional story-list flag: development requests development stories;
# production or unset uses the normal listing. This is not access control.
# This does not choose Vite mode or the deployment base path; the build script does.
VITE_APP_ENV=production

# Optional Zotero overrides; these are the defaults when omitted.
VITE_ZOTERO_API_URL=https://api.zotero.org
VITE_ZOTERO_API_VERSION=3

# Optional request settings; these defaults apply to Strapi and Zotero reads.
# Retry count is the number of retries after the first attempt; delay is in ms.
# VITE_API_TIMEOUT_MS=10000
# VITE_API_RETRY_COUNT=2
# VITE_API_RETRY_DELAY_MS=500

# Optional development helpers: local Strapi calls remain disabled by default.
# This does not redirect normal API calls; set VITE_STRAPI_URL for those.
# VITE_ENABLE_LOCAL_STRAPI=false
# VITE_LOCAL_STRAPI_URL=http://localhost:1337

# Optional legacy API client settings; normal CMS pages use VITE_STRAPI_URL.
# Local legacy mode falls back to VITE_API_URL if VITE_API_URL_LOCAL is unset.
# VITE_API_URL=
# VITE_ENABLE_LOCAL_API=false
# VITE_API_URL_LOCAL=

# Do not add VITE_ZOTERO_API_KEY or VITE_API_TOKEN. Remove them from all old
# .env files and build/container environments; populated values are rejected.
# VITE_PRODUCTION is a legacy unused setting; use VITE_APP_ENV for story listings.
# Review new public names in scripts/publicEnvironment.mjs before adding them.
